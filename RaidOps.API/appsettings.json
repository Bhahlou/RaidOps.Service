{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] [{ShortTypeName}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/raidops-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] [{ShortTypeName}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Discord": {
    "ClientId": "",
    "ClientSecret": "",
    "BotToken": "",
    "BotPermissions": "0",
    "DeployWebhookUrl": "",
    "BlizzardClassIconBaseUrl": "https://render.worldofwarcraft.com/us/icons/56/classicon_"
  },
  "FrontendUrl": "",
  "BattleNet": {
    "ClientId": "",
    "ClientSecret": "",
    "CallbackUrl": "https://raidops.app/api/v1.0/bnet/link/callback"
  }
}
